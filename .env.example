# Copie para .env e preencha com valores locais. Não inclua segredos reais neste arquivo.
DJANGO_SECRET_KEY=defina-uma-chave-secreta-local
DJANGO_DEBUG=True

DB_NAME=brainstream
DB_USER=brainstream
DB_PASSWORD=defina-uma-senha-local
DB_HOST=localhost
DB_PORT=3306

# Tutor Enéas. Deixe AI_API_KEY vazia para usar o tutor simulado de desenvolvimento.
# AI_PROVIDER: gemini ou anthropic. Vazio = detectar pela chave (chaves do Google começam com AIza).
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL vazio = padrão do provedor (gemini-3.5-flash-lite ou claude-opus-5-5).
# Use um modelo ativo: gemini-1.5-flash e gemini-2.5-flash-lite foram desativados pelo Google e retornam 404.
AI_MODEL=
# Busca na web (Google Search grounding) nas respostas do Enéas no Modo Guiado (só Gemini), usada só
# quando o tema ou a mensagem pedem fatos atuais. False desliga de vez (respostas mais rápidas).
# Exige um plano/cota do Gemini com a ferramenta; se ela for recusada, o Enéas responde sem busca.
AI_SEARCH=True

# Login com Google (OAuth 2.0). Crie um "ID do cliente OAuth" do tipo Aplicativo da Web no Google Cloud
# Console e cadastre o GOOGLE_REDIRECT_URI abaixo como URI de redirecionamento autorizado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback/
