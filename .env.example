# Copie para .env e preencha com valores do seu ambiente. Nunca inclua segredos reais neste arquivo.

# ---------- Django ----------
DJANGO_SECRET_KEY=defina-uma-chave-secreta-local
DJANGO_DEBUG=True
# Opcionais (separados por vírgula). Por padrão, domínios .vercel.app já são aceitos.
# Em produção, você pode restringir ao seu domínio exato, ex.: seu-projeto.vercel.app
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Na Vercel (VERCEL=1) com DEBUG=False o redirecionamento HTTPS já fica ativo por padrão.
DJANGO_SECURE_SSL_REDIRECT=False
# Minutos sem atividade até a sessão expirar e pedir novo login (padrão: 20).
SESSION_IDLE_MINUTES=20

# ---------- Banco de dados (MySQL local ou TiDB Cloud Starter) ----------
# Em desenvolvimento local: DB_HOST=localhost, DB_PORT=3306, DB_SSL_CA vazio.
# No TiDB Cloud Starter: DB_HOST=gateway01.<regiao>.prod.aws.tidbcloud.com, DB_PORT=4000
# e DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt (na Vercel/Linux) ou caminho do arquivo CA .pem local.
DB_NAME=brainstream
DB_USER=brainstream
DB_PASSWORD=defina-uma-senha-local
DB_HOST=localhost
DB_PORT=3306
DB_SSL_CA=

# ---------- Supabase Storage (API S3 para fotos de perfil / avatares) ----------
# Deixe todas vazias em desenvolvimento local para usar MEDIA_ROOT no disco.
# Em produção, preencha todas as 6 variáveis abaixo (configuração parcial gera erro explícito).
# Exemplo de bucket em produção: SUPABASE_S3_BUCKET=avatars
SUPABASE_PROJECT_REF=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=

# ---------- Login com Google (OAuth 2.0) ----------
# Crie um "ID do cliente OAuth" do tipo Aplicativo da Web no Google Cloud Console
# e cadastre o URI de redirecionamento autorizado (em produção: https://SEU-DOMINIO.vercel.app/accounts/google/callback/).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/accounts/google/callback/

# ---------- Tutor Enéas (IA) ----------
# Deixe AI_API_KEY vazia para usar o tutor simulado de desenvolvimento.
# AI_PROVIDER: gemini ou anthropic. Vazio = detectar pela chave (chaves do Google começam com AIza).
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL vazio = padrão do provedor (gemini-3.5-flash-lite ou claude-opus-5-5).
# Use um modelo ativo: gemini-1.5-flash e gemini-2.5-flash-lite foram desativados pelo Google e retornam 404.
AI_MODEL=
# Timeout (segundos) por requisição à API de IA. Mantido conservador para o ambiente serverless da Vercel.
AI_TIMEOUT=25
# Busca na web (Google Search grounding) nas respostas do Enéas no Modo Guiado (só Gemini).
# Deixe False nos primeiros testes em produção para respostas mais rápidas e previsíveis.
AI_SEARCH=False

# ---------- E-mail ----------
# Em desenvolvimento, os e-mails (ex.: recuperação de senha) aparecem no console do servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=BrainStream <nao-responda@brainstream.local>
